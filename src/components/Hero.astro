---
import PhotoSlot from "./PhotoSlot.astro";
import ActionLinks from "./ActionLinks.astro";
import Icon from "./Icon.astro";
import type { Locale } from "../i18n/locales";

interface Props {
  locale: Locale;
  name: string;
  headline: string;
  summary: string;
  location: string;
  availability: string;
  photoAlt: string;
  resumeHref: string;
  linkedinHref: string;
  githubHref: string;
  email: string;
}

const {
  locale,
  name,
  headline,
  summary,
  location,
  availability,
  photoAlt,
  resumeHref,
  linkedinHref,
  githubHref,
  email,
} = Astro.props;
---

<section id="intro" class="hero">
  <div class="container hero__grid">
    <div class="hero__photo">
      <PhotoSlot alt={photoAlt} />
    </div>
    <div class="hero__identity">
      <h1>{name}</h1>
      <p class="hero__headline">{headline}</p>
    </div>
    <div class="hero__actions">
      <ActionLinks
        locale={locale}
        resumeHref={resumeHref}
        linkedinHref={linkedinHref}
        githubHref={githubHref}
        email={email}
      />
    </div>
    <p class="hero__summary">{summary}</p>
    <p class="hero__meta text-small">
      <Icon name="map-pin" size={16} />
      {location} · {availability}
    </p>
  </div>
</section>

<style>
  .hero {
    padding-block: var(--space-12) var(--space-section);
  }

  .hero__grid {
    display: grid;
    gap: var(--space-4);
    grid-template-areas:
      "photo identity"
      "actions actions"
      "summary summary"
      "meta meta";
    grid-template-columns: auto 1fr;
    align-items: center;
  }

  .hero__photo {
    grid-area: photo;
    display: inline-flex;
  }

  .hero__identity {
    grid-area: identity;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--space-2);
    margin-left: var(--space-4);
  }

  .hero__actions {
    grid-area: actions;
  }

  .hero__summary {
    grid-area: summary;
  }

  .hero__meta {
    grid-area: meta;
    display: flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-muted);
  }

  .hero__headline {
    font-family: var(--font-mono);
    font-size: var(--text-small);
    color: var(--color-muted);
    margin: 0;
  }

  @media (min-width: 960px) {
    .hero__grid {
      grid-template-areas:
        "photo identity"
        "photo actions"
        "photo summary"
        "photo meta";
      grid-template-columns: 176px 1fr;
      column-gap: var(--space-8);
      row-gap: var(--space-4);
      align-items: start;
    }

    .hero__photo {
      align-items: flex-start;
    }

    .hero__identity {
      margin-left: 0;
      justify-content: flex-start;
      padding-top: var(--space-2);
    }
  }
</style>
