---
import Icon from "./Icon.astro";
import { dictionaries } from "../i18n/dictionaries";
import type { Locale } from "../i18n/locales";
import { withBase } from "../lib/paths";

interface Props {
  locale: Locale;
  email: string;
  linkedinHref: string;
  githubHref: string;
  resumeHref: string;
}

const { locale, email, linkedinHref, githubHref, resumeHref } = Astro.props;
const dict = dictionaries[locale];
---

<ul class="contact-block">
  <li>
    <a href={`mailto:${email}`}>
      <Icon name="mail" />
      {email}
    </a>
  </li>
  <li>
    <a href={linkedinHref} target="_blank" rel="noopener noreferrer">
      LinkedIn
      <Icon name="arrow-up-right" size={16} />
      <span class="visually-hidden">{dict.link.newTab}</span>
    </a>
  </li>
  <li>
    <a href={githubHref} target="_blank" rel="noopener noreferrer">
      <Icon name="github" />
      GitHub
      <Icon name="arrow-up-right" size={16} />
      <span class="visually-hidden">{dict.link.newTab}</span>
    </a>
  </li>
  <li>
    <a href={withBase(resumeHref)}>
      <Icon name="file-text" />
      {dict.action.resume}
    </a>
  </li>
</ul>

<style>
  .contact-block {
    list-style: none;
    margin: var(--space-6) 0 0;
    padding: 0;
    display: grid;
    gap: var(--space-3);
  }

  .contact-block a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-weight: 600;
    text-decoration: none;
  }
</style>
