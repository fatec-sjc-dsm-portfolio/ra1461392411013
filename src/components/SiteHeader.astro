---
import LangShortcut from "./LangShortcut.astro";
import ThemeSwitch from "./ThemeSwitch.astro";
import { dictionaries } from "../i18n/dictionaries";
import type { Locale } from "../i18n/locales";

interface Props {
  locale: Locale;
  name: string;
}

const { locale, name } = Astro.props;
const dict = dictionaries[locale];

const links: Array<{ href: string; label: string }> = [
  { href: "#intro", label: dict.nav.home },
  { href: "#experience", label: dict.nav.experience },
  { href: "#skills", label: dict.nav.skills },
  { href: "#projects", label: dict.nav.projects },
  { href: "#testimonials", label: dict.nav.testimonials },
  // #about desativada (D-38 em docs/SPEC.md); reative junto com a seção em index.astro.
  { href: "#contact", label: dict.nav.contact },
];
---

<header class="site-header">
  <div class="container site-header__inner">
    <a href="#intro" class="site-header__name"
      >{name}<span class="name-dot" aria-hidden="true">.</span></a
    >
    <nav aria-label={dict.nav.label} class="site-header__nav">
      <ul>
        {
          links.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="site-header__actions">
      <LangShortcut locale={locale} />
      <ThemeSwitch locale={locale} />
    </div>
  </div>
</header>

<style>
  .site-header {
    /* Precisa de fundo opaco: sem ele o conteúdo passa por trás. */
    background: var(--color-bg);
    border-bottom: var(--border-width) solid var(--color-border);
  }

  /* Abaixo de 640 px a navegação quebra em 3 linhas (148 px, 23% da tela
     de um celular) e pioraria no zoom de 200% exigido pela RNF-05. Então
     o cabeçalho só gruda a partir daí, onde ocupa 62 px. */
  @media (min-width: 640px) {
    .site-header {
      position: sticky;
      top: 0;
      /* Acima do conteúdo, abaixo do SkipLink (z-index 100). */
      z-index: 10;
    }
  }

  .site-header__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-4);
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .site-header__name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.125rem;
    color: var(--color-text);
    text-decoration: none;
  }

  .site-header__nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-header__nav a {
    color: var(--color-text);
    text-decoration: none;
    font-size: var(--text-small);
  }

  .site-header__nav a:hover {
    color: var(--color-accent);
  }

  @media (max-width: 640px) {
    .site-header__inner {
      flex-direction: row;
      flex-wrap: wrap;
    }

    .site-header__nav {
      order: 3;
      flex-basis: 100%;
    }
  }
</style>
